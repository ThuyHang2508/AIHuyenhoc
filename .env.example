# Không bắt buộc: người dùng có thể tự chọn AI và nhập API key ngay trên web (nút "Cài đặt AI").
# Điền key ở đây nếu muốn máy chủ có sẵn key mặc định cho mọi người dùng.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Đặt AI_MOCK=1 để xem thử giao diện chat khi chưa có API key nào
AI_MOCK=1
# Địa chỉ web khi đưa lên mạng (dùng cho sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=
# Lượt hỏi AI tối đa mỗi IP trong 10 phút (key máy chủ / key người dùng tự nhập)
RATE_LIMIT_SERVER_KEY=
RATE_LIMIT_OWN_KEY=
